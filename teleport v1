local player = game.Players.LocalPlayer

-- НАСТРОЙКИ (замени на свои координаты!)
local ISLANDS = {
    {name = "Остров 1 - Железная шахта", pos = Vector3.new(0, 100, 0)},
    {name = "Остров 2 - Доки", pos = Vector3.new(1000, 100, 500)},
    {name = "Остров 3 - Лес", pos = Vector3.new(-800, 100, -600)},
    -- Добавь свои острова сюда!
}

-- GUI
local screenGui = Instance.new("ScreenGui")
